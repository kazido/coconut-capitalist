# Copy to .env (git-ignored) and fill in.

# Discord bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
# Use a SEPARATE application/token for dev (config.ini "dev mode: yes") and prod.
BOT_TOKEN=

# Optional ------------------------------------------------------------------------------------
# SQLite database file (default: data/cococap.db, created automatically on first start)
#DATABASE_PATH=data/cococap.db
# Guild the bot waits for before loading its commands (default: the original server)
#GUILD_ID=
# Discord user id allowed to use the debug commands / receive reports
#OWNER_ID=
